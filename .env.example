NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-public-key
# Server only: the NEW project's secret/service-role key. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
# Optional: used by migration/backup commands, never by browser code.
DATABASE_URL=

# AI is disabled unless explicitly enabled after reviewing costs.
WEBSITE_AI_ENABLED=false
